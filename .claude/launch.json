  "version": "0.0.1",
  "configurations": [
    {
      "name": "shelfie-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "shelfie-test",
      "runtimeExecutable": "/usr/bin/env",
