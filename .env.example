# Copy to .env.local and fill in.

# Postgres (Neon or Supabase). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host:5432/shelfie

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Magic-link email via Resend (https://resend.com). Leave empty in development:
# the sign-in link is printed to the dev server log instead.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Shelfie <onboarding@resend.dev>"

# Google sign-in (optional). The Google button only shows when both are set.
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional metadata source (Google Books works without a key at low volume)
# GOOGLE_BOOKS_API_KEY=
