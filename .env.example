# Copy to .env.local and fill in. Nothing is required to run the UI shell yet.

# Postgres (Neon / Supabase) — needed once the data layer lands
# DATABASE_URL=postgres://user:password@host:5432/shelfie

# Auth.js
# AUTH_SECRET=generate-with-npx-auth-secret
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional metadata source (Google Books works without a key at low volume)
# GOOGLE_BOOKS_API_KEY=
